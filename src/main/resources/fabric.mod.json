  "authors": [
    "Fix85"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/gracejump",
    "sources": "https://github.com/Fix85/GraceJump",
    "issues": "https://github.com/Fix85/GraceJump/issues"
  },
  "license": "MIT",
  "icon": "assets/gracejump/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.fix85.gracejump.GraceJump"
    ],
    "modmenu": [
      "dev.fix85.gracejump.GraceJumpModMenu"
    ]
  },
  "mixins": [
    {
      "config": "gracejump.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=1.21.1",
