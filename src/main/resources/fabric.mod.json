  "authors": [
    "Fix85"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/edgejump",
    "sources": "https://github.com/Fix85/EdgeJump",
    "issues": "https://github.com/Fix85/EdgeJump/issues"
  },
  "license": "MIT",
  "icon": "assets/edgejump/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.fix85.edgejump.EdgeJump"
    ],
    "modmenu": [
      "dev.fix85.edgejump.EdgeJumpModMenu"
    ]
  },
  "mixins": [
    {
      "config": "edgejump.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
